# Copy this file to .env.local (git-ignored) and fill in your Supabase project's
# values — Settings -> API in the dashboard. Both are required at build/dev time;
# src/supabase/client.ts throws a clear error on startup if either is missing.
#
# VITE_SUPABASE_ANON_KEY is the public "anon" key. It is safe to ship in the
# client bundle: see docs/adr/0001-host-epoch-and-rpc-only-access.md for why
# the schema is designed so that key alone can't list or tamper with Rooms.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
